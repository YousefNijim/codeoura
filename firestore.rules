/**
 * Core Philosophy: This ruleset implements a "backend-only" access model for data management.
 * All write operations (create, update, delete) from client applications are denied across the board.
 * This ensures that data is only ever modified through a trusted server environment (e.g., Cloud Functions
 * with the Admin SDK), providing maximum security and data integrity.
 *
 * Data Structure: The database consists of two independent, top-level collections:
 * - /inquiries: A private collection for storing sensitive user contact form submissions.
 * - /portfolio_projects: A public collection for showcasing portfolio content.
 *
 * Key Security Decisions:
 * - Backend-Only Writes: To prevent any unauthorized modification, all client-side write
 *   access is disabled. Content and data must be managed via a secure backend process.
 * - Public Read for Content: The `/portfolio_projects` collection is publicly readable by anyone,
 *   including unauthenticated visitors, to allow the portfolio to be displayed.
 * - Private Data Lockdown: The `/inquiries` collection is completely locked down from all
 *   client-side read and write access to protect user privacy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description
     *   Locks down the entire `/inquiries` collection from any client-side access.
     *   This data is considered sensitive and should only be accessed by a trusted backend.
     * @path
     *   /inquiries/{inquiryId}
     * @allow
     *   No client requests are permitted. All operations will be denied.
     * @deny
     *   An anonymous user trying to (create) a new inquiry document.
     * @principle
     *   Protects sensitive user-submitted data by enforcing a backend-only access model.
     */
    match /inquiries/{inquiryId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *   Allows universal public read access for portfolio projects, but denies all
     *   client-side write operations. Content must be managed from a backend environment.
     * @path
     *   /portfolio_projects/{projectId}
     * @allow
     *   Any anonymous user can (get) or (list) all portfolio projects to view the site content.
     * @deny
     *   Even a signed-in user cannot (create) a new portfolio project from the client.
     * @principle
     *   Ensures public content is viewable by all, while modifications are restricted to a trusted backend environment.
     */
    match /portfolio_projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}